# Copy to .env.local for development. In production set these in Coolify,
# never in a committed file. This repo is public.
#
# Only VITE_-prefixed values reach the browser, and they are compiled into
# the bundle, so they must be safe to publish. Everything else is server-only.

# --- Clerk (dashboard → API keys) -----------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- PostgREST (private, on the Docker network) ---------------------------
# Locally http://127.0.0.1:3001; in Coolify http://<postgrest container>:3000
POSTGREST_URL=
# At least 32 random characters (openssl rand -hex 32). PostgREST's
# PGRST_JWT_SECRET must be the SAME value: the app signs, PostgREST verifies.
POSTGREST_JWT_SECRET=

# --- Files -----------------------------------------------------------------
# A persistent volume in production (/data/storage). Defaults to ./.storage.
STORAGE_DIR=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="Rentio <no-reply@your-domain.com>"
# Public https URL of the app; invite emails link here.
SITE_URL=

# --- Tooling only: bun run db:types / db:test / db:audit-late-fees ----------
# Real values belong in .env.local, never here.
DATABASE_URL=

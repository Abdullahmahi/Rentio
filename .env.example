# Supabase — Project Settings → API
# In Lovable these are injected automatically once Supabase is connected.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (edge functions / scripts). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `bun run db:types` and `bun run db:test`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres


Db Password="XfjvuF5TSrFBIPR9'"

# Lets `bun run db:types` read the catalog through the Management API when the
# database password for DATABASE_URL is not available.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
